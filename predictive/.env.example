# Settings for hiring_sagemaker_openscale.ipynb. Copy to .env and fill in.

# ---- AWS (SageMaker)
AWS_REGION="us-east-1"
SAGEMAKER_ROLE_ARN="arn:aws:iam::<account-id>:role/<SageMakerExecutionRole>"
ENDPOINT_NAME="hiring-model-endpoint"

# Access key that OpenScale uses to discover and score the endpoint
OPENSCALE_AWS_ACCESS_KEY_ID="<ACCESS_KEY_ID>"
OPENSCALE_AWS_SECRET_ACCESS_KEY="<SECRET_ACCESS_KEY>"

# ---- watsonx.governance on AWS
IBM_API_KEY="<IBM_API_KEY>"
PLATFORM_URL="https://us-east-1.aws.data.ibm.com"
OPENSCALE_URL="https://us-east-1.mm.aws.governance.ibm.com"
OPENSCALE_INSTANCE_ID="<OPENSCALE_INSTANCE_ID>"
SERVICE_PROVIDER_NAME="AWS SageMaker - Hiring demo"

# Only needed if no data mart exists yet (Aurora PostgreSQL or Db2), as one line of JSON:
# DB_CREDENTIALS='{"type": "postgresql", "hostname": "", "port": 5432, "username": "", "password": "", "database": "", "schema": "wos_hiring", "sslmode": "require", "certificate_base64": null}'

# ---- Data
DATA_DIR="."
LABEL="HIRED"
PROTECTED_ATTRIBUTE="IsFemale"
